#: pretix_google_wallet/apps.py:9 pretix_google_wallet/apps.py:12
#: pretix_google_wallet/signals.py:32
#: pretix_google_wallet/templates/pretix_google_wallet/organizer_settings.html:4
#: pretix_google_wallet/templates/pretix_google_wallet/organizer_settings.html:6
msgid "Google Wallet"
msgstr "Google Wallet"

#: pretix_google_wallet/apps.py:14
msgid "Add native Google Wallet event tickets to pretix orders."
msgstr "Přidává nativní vstupenky Google Wallet k objednávkám v pretixu."

#: pretix_google_wallet/fields.py:15
msgid "Enter a valid service account JSON document."
msgstr "Zadejte platný JSON účtu služby."

#: pretix_google_wallet/fields.py:17
msgid "The JSON must contain a service account client email and private key."
msgstr "JSON musí obsahovat e-mail klienta a soukromý klíč účtu služby."

#: pretix_google_wallet/forms.py:10
msgid "The Google Wallet issuer ID contains digits only."
msgstr "ID vydavatele Google Wallet smí obsahovat pouze číslice."

#: pretix_google_wallet/forms.py:15
msgid "Enter a hexadecimal color in the format #rrggbb."
msgstr "Zadejte hexadecimální barvu ve formátu #rrggbb."

#: pretix_google_wallet/forms.py:17
msgid "Google Wallet issuer ID"
msgstr "ID vydavatele Google Wallet"

#: pretix_google_wallet/forms.py:22
msgid "Google service account JSON"
msgstr "JSON účtu služby Google"

#: pretix_google_wallet/forms.py:24
msgid ""
"Stored as a masked setting. Leave empty to use the "
"GOOGLE_APPLICATION_CREDENTIALS environment variable."
msgstr ""
"Ukládá se jako maskované nastavení. Ponecháte-li pole prázdné, použije se "
"proměnná prostředí GOOGLE_APPLICATION_CREDENTIALS."

#: pretix_google_wallet/templates/pretix_google_wallet/organizer_settings.html:8
msgid ""
"Enable the Google Wallet API, authorize the service account as a Developer "
"in the Google Pay and Wallet console, and enter the issuer ID below. You can "
"configure credentials globally, for this organizer, or through "
"GOOGLE_APPLICATION_CREDENTIALS on the server."
msgstr ""
"Povolte Google Wallet API, přidejte účet služby jako vývojáře v konzoli "
"Google Pay a Wallet a níže zadejte ID vydavatele. Přihlašovací údaje lze "
"nastavit globálně, pro tohoto pořadatele nebo pomocí proměnné prostředí "
"GOOGLE_APPLICATION_CREDENTIALS na serveru."

#: pretix_google_wallet/templates/pretix_google_wallet/organizer_settings.html:19
msgid "Save"
msgstr "Uložit"

#: pretix_google_wallet/ticketoutput.py:14
msgid "Google Wallet event tickets"
msgstr "Vstupenky Google Wallet"

#: pretix_google_wallet/ticketoutput.py:16
#: pretix_google_wallet/ticketoutput.py:18
msgid "Add to Google Wallet"
msgstr "Přidat do Peněženky Google"

#: pretix_google_wallet/ticketoutput.py:17
msgid "Add all to Google Wallet"
msgstr "Přidat vše do Peněženky Google"

#: pretix_google_wallet/ticketoutput.py:34
msgid "Google Wallet hero image"
msgstr "Hlavní obrázek Google Wallet"

#: pretix_google_wallet/ticketoutput.py:36
msgid "Optional wide event image. It must be publicly reachable over HTTPS."
msgstr "Volitelný široký obrázek akce. Musí být veřejně dostupný přes HTTPS."

#: pretix_google_wallet/ticketoutput.py:47
msgid "Google Wallet logo"
msgstr "Logo Google Wallet"

#: pretix_google_wallet/ticketoutput.py:49
msgid "Optional logo. It must be publicly reachable over HTTPS; the event or organizer logo is used otherwise."
msgstr "Volitelné logo. Musí být veřejně dostupné přes HTTPS; jinak se použije logo akce nebo organizátora."

#: pretix_google_wallet/ticketoutput.py:59
msgid "Google Wallet background color"
msgstr "Barva pozadí Google Wallet"

#: pretix_google_wallet/ticketoutput.py:61
msgid "Optional hexadecimal color, for example #920c0b. The event shop color is used otherwise."
msgstr "Volitelná hexadecimální barva, například #920c0b. Jinak se použije barva obchodu akce."

#: pretix_google_wallet/views.py:82
msgid "Your changes have been saved."
msgstr "Změny byly uloženy."

#: pretix_google_wallet/views.py:107 pretix_google_wallet/views.py:113
#: pretix_google_wallet/views.py:137 pretix_google_wallet/views.py:143
msgid "Ticket download is not available."
msgstr "Stažení vstupenky není dostupné."

#: pretix_google_wallet/views.py:124
msgid "The Google Wallet ticket could not be created. Please try again later."
msgstr ""
"Vstupenku Google Wallet se nepodařilo vytvořit. Zkuste to prosím později."

#: pretix_google_wallet/views.py:154
msgid "The Google Wallet tickets could not be created. Please try again later."
msgstr "Vstupenky Google Wallet se nepodařilo vytvořit. Zkuste to prosím později."

msgid "Google Wallet hero images"
msgstr "Hlavní obrázky Peněženky Google"

msgid "Leave empty to use the event or organizer fallback."
msgstr "Ponechte prázdné pro použití obrázku akce nebo organizátora."

msgid "The subevent hero images have been saved."
msgstr "Hlavní obrázky termínů byly uloženy."

msgid "Optionally set a separate hero image for each event date. Empty fields use the event-level and organizer-level fallbacks."
msgstr "Volitelně nastavte samostatný hlavní obrázek pro každý termín. Prázdná pole použijí obrázek akce nebo organizátora."

msgid "Event date"
msgstr "Termín akce"

msgid "Hero image"
msgstr "Hlavní obrázek"

msgid "This event has no dates."
msgstr "Tato akce nemá žádné termíny."
"Vstupenku Google Wallet se nepodařilo vytvořit. Zkuste to prosím později."
